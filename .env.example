# TruthLens v8 Production Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to git - it contains sensitive credentials

# ===== FLASK CONFIG =====
FLASK_ENV=production
SECRET_KEY=truthlens-v8-production-secret-key-change-me
PORT=3000
HOST=0.0.0.0

# ===== TAVILY REAL-TIME SEARCH API =====
# Get from: https://tavily.com/ (Free tier: 1000 credits/month)
TAVILY_API_KEY=your_tavily_api_key_here

# ===== GEMINI API (History Title Generator) =====
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ===== MONGODB CLOUD DATABASE =====
# Get from: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/truthlens_db

# ===== NEWS & WEATHER API KEYS =====
# Get from: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Get from: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_key_here

# Get from: https://weatherapi.com/
WEATHER_API_KEY=your_weather_api_key

# Get from: https://rapidapi.com/ (Cricbuzz Cricket)
CRICBUZZ_KEY=your_cricbuzz_key

# ===== DEPLOYMENT =====
PRODUCTION_MODE=True
LOG_LEVEL=INFO
